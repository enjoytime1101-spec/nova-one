# Runtime state and signing keys. The CLI reads this variable. Never commit this directory.
NOVA_HOME=./.nova

# Reference secret for first initialisation. The runtime does not read it implicitly:
# pass it explicitly with `nova-one init --api-token "$NOVA_API_TOKEN"`.
NOVA_API_TOKEN=replace-with-43-to-256-base64url-random-characters

# Host, port, and external capabilities are explicit CLI/programmatic options, not
# ambient environment toggles. External data, model, and execution remain disabled
# unless an embedding application supplies scoped adapters and allowlists.
